# LinkedIn Session Cookie (li_at)
# Get this from Chrome DevTools:
#   1. Open linkedin.com and log in
#   2. Press F12 (DevTools)
#   3. Go to Application tab → Cookies → https://www.linkedin.com
#   4. Find "li_at" and copy its Value
#   5. Paste it below (remove the example text)

LINKEDIN_COOKIE=your_li_at_cookie_value_here

# Optional: Proxy URL for IP rotation (not required for small-scale usage)
# Format: http://username:password@proxy-server.com:8080
# or socks5://username:password@proxy-server.com:1080
# Only needed if:
#   - Running on cloud/datacenter IP (AWS, GCP, Azure)
#   - Scraping 100+ profiles/day
#   - Using multiple accounts simultaneously
# PROXY_URL=

# Optional: Set to 1 for debug logging
# DEBUG=1
